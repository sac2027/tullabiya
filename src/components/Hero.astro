---
import { Image } from 'astro:assets';
import HeroGreeting from '~/components/islands/HeroGreeting';
import { L, monthName, t } from '~/i18n';
import { photo } from '~/lib/photos';
import type { CollegeId, EventItem, Issue, Lang } from '~/lib/model';
import { COLLEGES } from '~/lib/model';

interface Props {
  lang: Lang;
  issue: Issue;
  events: EventItem[];
}
const { lang, issue, events } = Astro.props;
const perCollege: Partial<Record<CollegeId, number>> = {};
for (const c of COLLEGES) perCollege[c.id] = events.filter((e) => e.colleges !== 'all' && e.colleges.includes(c.id)).length;
const month = monthName(lang, issue.year, issue.month);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <HeroGreeting client:load lang={lang} issue={issue.number} month={month} totalEvents={events.length} perCollege={perCollege} />
    <div class="hero-cta">
      <a class="btn on-field" href="#month">{t(lang, 'hero.start')}</a>
      <a class="btn ghost on-field" href="#pulse">{t(lang, 'hero.quick')}</a>
    </div>
  </div>
  <div class="hero-photo fast-photo" style="--slant: 96px">
    <Image src={photo(issue.coverPhoto)} alt={L(issue.coverAlt, lang)} widths={[640, 960, 1280]} sizes="(max-width: 1023px) 100vw, 50vw" loading="eager" fetchpriority="high" />
    <div class="hero-label fast-label">{L(issue.coverLine, lang)}</div>
  </div>
</section>
