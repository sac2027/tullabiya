---
import LangSwitch from '~/components/islands/LangSwitch';
import ProfileChip from '~/components/islands/ProfileChip';
import { t } from '~/i18n';
import type { Lang } from '~/lib/model';

interface Props {
  lang: Lang;
  issue: number;
  current?: 'home' | 'calendar' | 'opportunities' | 'community' | 'archive' | 'my';
}
const { lang, issue, current } = Astro.props;
const links: { key: Props['current']; href: string; label: string }[] = [
  { key: 'home', href: `/${lang}/`, label: t(lang, 'nav.current') },
  { key: 'calendar', href: `/${lang}/calendar/`, label: t(lang, 'nav.calendar') },
  { key: 'opportunities', href: `/${lang}/opportunities/`, label: t(lang, 'nav.opportunities') },
  { key: 'community', href: `/${lang}/community/`, label: t(lang, 'nav.community') },
  { key: 'archive', href: `/${lang}/archive/`, label: t(lang, 'nav.archive') },
];
---
<header class="bar">
  <a class="mark" href={`/${lang}/`} aria-label={t(lang, 'site.name')}>الطلّابية</a>
  <nav class="nav" aria-label={t(lang, 'nav.menu')}>
    {links.map((l) => (
      <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <div class="tools">
    <LangSwitch client:load lang={lang} pathname={Astro.url.pathname} />
    <button
      type="button"
      class="tool theme"
      id="themeBtn"
      aria-label={t(lang, 'theme.dark')}
      data-label-dark={t(lang, 'theme.dark')}
      data-label-light={t(lang, 'theme.light')}
      aria-pressed="false"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
        <path d="M8.5 3h7l5 5v7l-5 5h-7l-5-5V8z" />
        <path class="theme-fill" d="M12 7a5 5 0 0 1 0 10z" fill="currentColor" stroke="none" />
      </svg>
    </button>
    <ProfileChip client:idle lang={lang} issue={issue} />
  </div>
</header>

<script>
  import { KEYS } from '~/lib/model';
  const btn = document.getElementById('themeBtn') as HTMLButtonElement | null;
  const root = document.documentElement;
  function sync() {
    if (!btn) return;
    const dark = root.getAttribute('data-theme') === 'dark';
    btn.setAttribute('aria-pressed', String(dark));
    btn.setAttribute('aria-label', dark ? btn.dataset.labelLight! : btn.dataset.labelDark!);
  }
  btn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theming', '');
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem(KEYS.theme, JSON.stringify(next));
    } catch {}
    sync();
    setTimeout(() => root.removeAttribute('data-theming'), 260);
  });
  sync();
</script>
