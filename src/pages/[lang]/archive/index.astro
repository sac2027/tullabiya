---
import '~/styles/archive.css';
import Base from '~/layouts/Base.astro';
import TopBar from '~/components/TopBar.astro';
import Footer from '~/components/Footer.astro';
import ArchiveWall from '~/components/islands/ArchiveWall';
import SearchBox from '~/components/islands/SearchBox';
import { currentIssue, loadAll } from '~/data';
import { L, t, tp } from '~/i18n';
import type { Lang } from '~/lib/model';

export function getStaticPaths() {
  return [{ params: { lang: 'ar' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
const bundle = loadAll();
const issue = currentIssue();
const issues = bundle.archive.map((a) => a.number).sort((a, b) => b - a);
const fallback = bundle.stories.map((s) => ({
  title: L(s.title, lang),
  url: `/${lang}/issue/${s.issue}/${s.slug}/`,
  text: `${L(s.summary, lang)} ${(s.body?.ar ?? []).join(' ')} ${(s.body?.en ?? []).join(' ')}`.slice(0, 4000),
}));
---
<Base lang={lang} title={`${t(lang, 'nav.archive')} | ${t(lang, 'site.name')}`} description={t(lang, 'arch.lead')}>
  <TopBar lang={lang} issue={issue.number} current="archive" />
  <main id="main" class="wrap arch-page">
    <h1>{tp(lang, 'arch.title', issues.length)}</h1>
    <p class="lead">{t(lang, 'arch.lead')}</p>
    <SearchBox client:idle lang={lang} fallback={fallback} />
    <ArchiveWall client:load lang={lang} issues={issues} currentIssue={issue.number} />
  </main>
  <Footer lang={lang} />
</Base>
