---
import '~/styles/story.css';
import { Image, getImage } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import TopBar from '~/components/TopBar.astro';
import Footer from '~/components/Footer.astro';
import EntityChip from '~/components/islands/EntityChip';
import Reactions from '~/components/islands/Reactions';
import ShareQuote from '~/components/islands/ShareQuote';
import ReadingProgress from '~/components/islands/ReadingProgress';
import SaveStory from '~/components/islands/SaveStory';
import { loadAll, personById, storiesOf, unitById } from '~/data';
import { L, localized, t, tp } from '~/i18n';
import { actionsFor } from '~/lib/entities';
import { photo, hasPhoto } from '~/lib/photos';
import { SECTIONS, type Lang, type Story } from '~/lib/model';
import { initial } from '~/lib/name';

export function getStaticPaths() {
  const b = loadAll();
  return (['ar', 'en'] as Lang[]).flatMap((lang) =>
    b.stories.map((s) => ({ params: { lang, n: String(s.issue), slug: s.slug }, props: { story: s } })),
  );
}
const lang = Astro.params.lang as Lang;
const { story } = Astro.props as { story: Story };
const bundle = loadAll();
const issue = bundle.issues.find((i) => i.number === story.issue)!;
const section = SECTIONS.find((s) => s.id === story.section)!;
const title = localized(story.title, lang);
const body = story.body ? (lang === 'en' && story.body.en ? { paras: story.body.en, fallback: false } : { paras: story.body.ar, fallback: lang === 'en' }) : null;
const machine = lang === 'en' && story.title.enStatus === 'machine';
const author = story.authorId ? personById(story.authorId) : null;
const unit = unitById(story.unitIds[0]);
const chip = author
  ? { kind: 'person' as const, id: author.id, name: L(author.name, lang), sub: L(author.role, lang), actions: actionsFor({ kind: 'person', id: author.id }, bundle) }
  : { kind: 'unit' as const, id: unit.id, name: L(unit.name, lang), sub: undefined, actions: actionsFor({ kind: 'unit', id: unit.id }, bundle, title.text) };
const more = storiesOf(story.issue).filter((s) => s.section === story.section && s.id !== story.id).slice(0, 3);
const coverImg = await getImage({ src: photo(issue.coverPhoto), width: 1080, format: 'jpg' });
const printed = `/archive/${story.issue}/p${String(story.pdfPage).padStart(2, '0')}.jpg`;
const pageTitle = `${title.text} | ${t(lang, 'site.name')}`;
const isList = story.body?.ar.every((p) => /^\d+\. /.test(p));
---
<Base lang={lang} title={pageTitle} description={L(story.summary, lang)}>
  <ReadingProgress client:load lang={lang} issue={story.issue} section={story.section} articleSelector="#story" />
  <TopBar lang={lang} issue={issue.number} />
  <main id="main" class="wrap story">
    <article id="story" data-pagefind-body>
      <header class="story-head">
        <h1>{title.text}</h1>
        <div class="story-meta">
          <span class="by">
            <span class="av" aria-hidden="true">{initial(chip.name)}</span>
            <EntityChip client:idle lang={lang} kind={chip.kind} id={chip.id} name={chip.name} sub={chip.sub} actions={chip.actions} />
          </span>
          <span>{L(section.name, lang)}</span>
          <span>{tp(lang, 'voices.minutes', story.readingMinutes)}</span>
          <a href={`/${lang}/#${story.section === 'news' ? 'main' : story.section === 'guest' ? 'guest' : 'voices'}`}>{t(lang, 'story.back')}</a>
        </div>
      </header>

      {hasPhoto(story.photo) && (
        <figure class="story-photo fast-photo">
          <Image src={photo(story.photo)} alt={L(story.photoAlt ?? story.title, lang)} widths={[720, 1200]} sizes="(max-width: 1023px) 100vw, 900px" loading="eager" />
          {story.photoCredit && <figcaption>{L(story.photoCredit, lang)}</figcaption>}
        </figure>
      )}

      {machine && <p class="lang-note">{t(lang, 'notice.machine')}</p>}
      {body?.fallback && <p class="lang-note" data-fallback>{t(lang, 'notice.notTranslated')}</p>}

      {story.quote && <blockquote class="story-quote">«{L(story.quote, lang)}»</blockquote>}

      <div class="story-body" lang={body?.fallback ? 'ar' : lang} dir={body?.fallback ? 'rtl' : undefined}>
        {body && !isList && body.paras.map((p) => <p>{p}</p>)}
        {body && isList && (
          <ol>
            {body.paras.map((p) => <li>{p.replace(/^\d+\.\s*/, '')}</li>)}
          </ol>
        )}
        {!body && <p>{L(story.summary, lang)}</p>}
        {story.steps && (
          <ol>
            {story.steps.map((s) => (
              <li>
                <strong>{L(s.label, lang)}, {L(s.when, lang)}</strong>
                {L(s.note, lang)}
              </li>
            ))}
          </ol>
        )}
      </div>

      <div class="story-actions">
        <Reactions client:visible lang={lang} storyId={story.id} />
      </div>
      <div class="story-actions">
        <SaveStory client:idle lang={lang} storyId={story.id} />
        <ShareQuote client:idle lang={lang} issue={story.issue} storyId={story.id} source={title.text} issueLine={t(lang, 'share.from', { issue: story.issue })} coverUrl={coverImg.src} coverLine={L(issue.coverLine, lang)} bodySelector=".story-body" />
        <button type="button" class="btn sm ghost" data-listen data-stop={t(lang, 'story.listening')} data-start={t(lang, 'story.listen')} hidden>{t(lang, 'story.listen')}</button>
      </div>
      <div class="story-end" aria-hidden="true"></div>
    </article>

    <section class="printed" aria-labelledby="printed-title">
      <h2 id="printed-title">{t(lang, 'story.printed')}</h2>
      <img src={printed} alt={t(lang, 'story.printedAlt', { n: story.pdfPage })} width={918} height={1298} loading="lazy" />
    </section>

    {more.length > 0 && (
      <section class="more" aria-labelledby="more-title">
        <h2 id="more-title">{t(lang, 'story.more', { section: L(section.name, lang) })}</h2>
        <ul>
          {more.map((s) => (
            <li><a href={`/${lang}/issue/${s.issue}/${s.slug}/`}>{L(s.title, lang)}</a></li>
          ))}
        </ul>
      </section>
    )}
  </main>
  <Footer lang={lang} />
</Base>

<script>
  // Listen: the browser's own voices, shown only where they exist. Stopping is instant.
  const btn = document.querySelector<HTMLButtonElement>('[data-listen]');
  const body = document.querySelector<HTMLElement>('.story-body');
  if (btn && body && 'speechSynthesis' in window) {
    btn.hidden = false;
    let speaking = false;
    btn.addEventListener('click', () => {
      if (speaking) {
        speechSynthesis.cancel();
        speaking = false;
        btn.textContent = btn.dataset.start ?? '';
        return;
      }
      const u = new SpeechSynthesisUtterance(body.innerText);
      u.lang = body.getAttribute('lang') ?? document.documentElement.lang;
      u.onend = () => {
        speaking = false;
        btn.textContent = btn.dataset.start ?? '';
      };
      speechSynthesis.speak(u);
      speaking = true;
      btn.textContent = btn.dataset.stop ?? '';
    });
  }
</script>
