---
import Base from '~/layouts/Base.astro';
import TopBar from '~/components/TopBar.astro';
import Hero from '~/components/Hero.astro';
import NewsBlock from '~/components/NewsBlock.astro';
import VoicesBlock from '~/components/VoicesBlock.astro';
import OpportunitiesBlock from '~/components/OpportunitiesBlock.astro';
import ArchiveTeaser from '~/components/ArchiveTeaser.astro';
import Footer from '~/components/Footer.astro';
import FavoritesBand from '~/components/islands/FavoritesBand';
import EndOfIssue from '~/components/islands/EndOfIssue';
import Onboarding from '~/components/islands/Onboarding';
import MonthStrip from '~/components/islands/MonthStrip';
import { mailto } from '~/lib/entities';
import { currentIssue, eventsInMonth, loadAll, personById, storiesOf } from '~/data';
import { formatDate, L, monthName, t } from '~/i18n';
import { nextIssueDate } from '~/lib/progress';
import { SECTIONS, type Lang } from '~/lib/model';

export function getStaticPaths() {
  return [{ params: { lang: 'ar' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
const bundle = loadAll();
const issue = currentIssue();
const events = eventsInMonth(issue.year, issue.month);
const stories = storiesOf(issue.number);
const lead = stories.find((s) => s.id === issue.leadStoryId)!;
const newsSide = stories.filter((s) => s.section === 'news' && s.id !== lead.id).slice(0, 2);
const big = stories.find((s) => s.section === 'experience')!;
const voicesSide = stories.filter((s) => s.section === 'contributions' && s.authorId && s.id !== '21-letter').slice(0, 2);
const guest = personById(issue.guestId);
const month = monthName(lang, issue.year, issue.month);
const funPoll = bundle.polls.find((p) => p.kind === 'fun' && p.issue === issue.number)!;
const hunt = bundle.hunts.find((h) => h.issue === issue.number)!;
/** Prototype "today": the demo date the mockup used. A real build uses the real date. */
const TODAY = '2026-09-12';
const nextDate = formatDate(lang, nextIssueDate(issue.date));
const unitNames: Record<string, string> = {};
const contactHrefs: Record<string, string> = {};
for (const u of bundle.units) {
  unitNames[u.id] = L(u.name, lang);
  contactHrefs[u.id] = mailto(u.email ?? 'dsa-mag@kfupm.edu.sa', L(u.name, lang));
}
const title = t(lang, 'site.issueTitle', { issue: issue.number });
const description = `${L(issue.coverLine, lang)}. ${L(lead.summary, lang)}`;
---
<Base lang={lang} title={title} description={description}>
  <div class="notice" role="note" data-notice>
    <span>{t(lang, 'notice.sample', { issue: issue.number })}</span>
    <button type="button" data-notice-hide>{t(lang, 'notice.hide')}</button>
  </div>
  <TopBar lang={lang} issue={issue.number} current="home" />
  <main id="main">
    <Hero lang={lang} issue={issue} events={events} />

    <section class="favs" aria-labelledby="favs-title">
      <FavoritesBand client:idle lang={lang} issue={issue.number} />
    </section>

    <section class="month sec" id="month" aria-labelledby="month-title">
      <div class="wrap">
        <div class="month-head">
          <div>
            <h2 id="month-title">{t(lang, 'month.title', { month })}</h2>
          </div>
          <p>{t(lang, 'month.lead')}</p>
        </div>
        <MonthStrip
          client:idle
          lang={lang}
          issue={issue.number}
          year={issue.year}
          month={issue.month}
          monthLabel={month}
          today={TODAY}
          events={events}
          unitNames={unitNames}
          contactHrefs={contactHrefs}
        />
      </div>
    </section>

    <section class="pulse sec" id="pulse" aria-labelledby="pulse-title">
      <div class="wrap">
        <h2 id="pulse-title">{L(funPoll.question, lang)}</h2>
        <p class="lead">{t(lang, 'pulse.voteFirst')}</p>
        <div data-pulse></div>
      </div>
    </section>

    <NewsBlock lang={lang} lead={lead} side={newsSide} />

    <section class="hunt sec" id="hunt" aria-labelledby="hunt-title">
      <div class="wrap">
        <h2 id="hunt-title">{t(lang, 'hunt.title', { month })}</h2>
        <p class="riddle">{L(hunt.riddle, lang)}</p>
        <div data-hunt></div>
      </div>
    </section>

    <section class="guest sec" id="guest" aria-labelledby="guest-title">
      <div class="wrap">
        <h2 id="guest-title">{t(lang, 'guest.title', { name: L(guest.name, lang) })}</h2>
        <p class="who">{t(lang, 'guest.lead')}</p>
        <div data-guest></div>
      </div>
    </section>

    <VoicesBlock lang={lang} big={big} side={voicesSide} />
    <OpportunitiesBlock lang={lang} events={events} today={TODAY} limit={3} />
    <ArchiveTeaser lang={lang} issues={bundle.archive.map((a) => a.number).sort((a, b) => b - a)} currentIssue={issue.number} />
    <EndOfIssue client:visible lang={lang} issue={issue.number} nextDate={nextDate} sectionCount={SECTIONS.length} />
  </main>
  <Footer lang={lang} />
  <Onboarding client:idle lang={lang} issue={issue.number} />
</Base>

<script>
  document.querySelector('[data-notice-hide]')?.addEventListener('click', () => {
    document.querySelector('[data-notice]')?.remove();
  });
</script>
